# Docker Compose runtime configuration. Copy this file to .env and replace every
# value beginning with "replace-with-" before starting the stack.
OVIRT_INVENTORY_IMAGE=ghcr.io/dennis-au/ovirt_stocktake:v0.1.12
OVIRT_INVENTORY_HOST_PORT=3001

# PostgreSQL is required by the Compose deployment for normalized inventory and
# Capacity metrics. Use a URL-safe password, such as: openssl rand -hex 32
POSTGRES_DB=ovirt_inventory
POSTGRES_USER=ovirt_inventory
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

# Required for login and encrypted Manager credential storage.
OVIRT_INVENTORY_SESSION_SECRET=replace-with-a-long-random-session-secret
OVIRT_INVENTORY_SESSION_TTL_HOURS=12
OVIRT_INVENTORY_SECURE_COOKIES=false
OVIRT_INVENTORY_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
OVIRT_INVENTORY_ADMIN_USERNAME=admin
OVIRT_INVENTORY_ADMIN_ROLE=admin
# Use a generated admin password. The application hashes it in memory at startup.
OVIRT_INVENTORY_ADMIN_PASSWORD=replace-with-an-admin-password

# Compose sets the PostgreSQL backend and enables collection so Capacity metrics
# are available after Managers are configured. These values control the cadence.
OVIRT_INVENTORY_INVENTORY_SYNC_MINUTES=15
OVIRT_INVENTORY_METRICS_SYNC_MINUTES=5

# Lab-only escape hatch for self-signed oVirt Manager certificates.
# Keep false in production; prefer NODE_EXTRA_CA_CERTS with a trusted CA.
OVIRT_INVENTORY_OVIRT_ALLOW_INSECURE_TLS=false
