OVIRT_INVENTORY_HOST=0.0.0.0
OVIRT_INVENTORY_PORT=3000
OVIRT_INVENTORY_DB_PATH=.data/ovirt-inventory.sqlite

# Revamp target: PostgreSQL normalized inventory store.
# Keep empty until the PostgreSQL migration milestone is enabled.
OVIRT_INVENTORY_DATABASE_URL=
OVIRT_INVENTORY_DATABASE_SSL=false

# Required before enabling login and credential storage.
OVIRT_INVENTORY_SESSION_SECRET=
OVIRT_INVENTORY_SESSION_TTL_HOURS=12
OVIRT_INVENTORY_ENCRYPTION_KEY=
OVIRT_INVENTORY_ADMIN_USERNAME=admin
OVIRT_INVENTORY_ADMIN_ROLE=admin
OVIRT_INVENTORY_ADMIN_PASSWORD_HASH=

# Revamp target: metrics and scheduled collection configuration.
OVIRT_INVENTORY_METRICS_BACKEND=none
OVIRT_INVENTORY_METRICS_URL=
OVIRT_INVENTORY_COLLECTOR_ENABLED=false
OVIRT_INVENTORY_INVENTORY_SYNC_MINUTES=15
OVIRT_INVENTORY_EXTENDED_SYNC_MINUTES=60
OVIRT_INVENTORY_EVENT_SYNC_MINUTES=5
OVIRT_INVENTORY_METRICS_SYNC_MINUTES=5
OVIRT_INVENTORY_BACKUP_SYNC_MINUTES=60
OVIRT_INVENTORY_FULL_SNAPSHOT_HOUR=2

# Lab-only escape hatch for self-signed oVirt Manager certificates.
# Keep false in production; prefer NODE_EXTRA_CA_CERTS with a trusted CA.
OVIRT_INVENTORY_OVIRT_ALLOW_INSECURE_TLS=false
